# Copy to .env for local work. Never commit .env. Values below are placeholders.
# REQUIRED in production (Render has both already): SECRET_KEY, DATABASE_URL.
# The app refuses to start without SECRET_KEY, and without DATABASE_URL when DEBUG is not True.

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-long-random-secret-key
# True only on your own machine. Anything other than the word True means off.
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3

# Optional
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Number of trusted proxies in front of the app (0 locally; 1 on Render).
NUM_PROXIES=0
# Admin path. Default is site-admin/ when unset. Pick your own hard-to-guess word in production.
ADMIN_URL=site-admin/
# Set to true only after testing (see docs/SECURITY_AUDIT.md). Default off.
DATABASE_SSL_REQUIRE=false
# HSTS lifetime in seconds when DEBUG is off (default 31536000 = one year).
# HSTS_SECONDS=31536000
# Set automatically by Render; used when ALLOWED_HOSTS is empty.
# RENDER_EXTERNAL_HOSTNAME=
